APP_NAME="MIŚ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<twoja-domena.pl>

APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pl_PL
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<nazwa bazy>
DB_USERNAME=<użytkownik bazy>
DB_PASSWORD=<hasło bazy>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Za proxy lub load balancerem wpisz jego adres, np. 10.0.0.1
TRUSTED_PROXIES=

# Prawdziwy serwer poczty: kody logowania, reset hasła, potwierdzenie e-maila
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<serwer SMTP>
MAIL_PORT=587
MAIL_USERNAME=<login SMTP>
MAIL_PASSWORD=<hasło SMTP>
MAIL_FROM_ADDRESS="no-reply@<twoja-domena.pl>"
MAIL_FROM_NAME="${APP_NAME}"

# Czat na żywo. Bez działającego procesu reverb:start ustaw BROADCAST_CONNECTION=null
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=<twoja-domena.pl>
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=<twoja-domena.pl>

# Wkompilowywane w JavaScript przy npm run build. Pusty adres = domena strony.
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# Ikony wyposażenia z Font Awesome (opcjonalnie)
FONT_AWESOME_API_TOKEN=

# Czas przechowywania kont (config/retention.php)
RETENTION_UNVERIFIED_ACCOUNT_DAYS=30
RETENTION_INACTIVE_ACCOUNT_MONTHS=36
